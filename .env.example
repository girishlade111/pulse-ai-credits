# Copy to .env and fill in real values. Never commit .env.

# --- LLM providers (OpenAI-compatible) ---
# The dev-server proxy reads these and attaches the matching key per request,
# so none of them reach the client bundle. Add a provider by appending a
# *_BASE_URL / *_MODEL / *_API_KEY triple and a matching entry in
# src/lib/providers.ts.
#
# apinex — https://api.apinex.bond/docs
APINEX_BASE_URL="https://api.apinex.bond/v1"
APINEX_MODEL="free/gpt-6-luna"
APINEX_API_KEY="sk-replace-me"

# atria — https://api.atria-asi.ai/docs
ATRIA_BASE_URL="https://api.atria-asi.ai/v1"
ATRIA_MODEL="Atria-Dawn-Preview"
ATRIA_API_KEY="atr-replace-me"

# mistral — https://docs.mistral.ai/api
MISTRAL_BASE_URL="https://api.mistral.ai/v1"
MISTRAL_MODEL="mistral-small-latest"
MISTRAL_API_KEY="mstrl-replace-me"

# inception — https://docs.inceptionlabs.ai/get-started
INCEPTION_BASE_URL="https://api.inceptionlabs.ai/v1"
INCEPTION_MODEL="mercury-2.5"
INCEPTION_API_KEY="sk-replace-me"

# --- Supabase (public catalog reads only; auth was removed) ---
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# --- Neon ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"
NEON_BRANCH="production"
NEON_AUTH_BASE_URL=""
NEON_AUTH_JWKS_URL=""

# --- AWS (S3-compatible object storage) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
