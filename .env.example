# Copy to .env and fill in real values. Never commit .env.

# --- LLM provider (OpenAI-compatible) ---
# Base URL for the chat completions API. No trailing slash.
LLM_BASE_URL="https://api.apinex.bond/v1"
# Model id, e.g. free/gpt-6-luna
LLM_MODEL="free/gpt-6-luna"
# Server-side only. Used by the proxy, never exposed to the browser bundle.
LLM_API_KEY="sk-replace-me"

# --- Supabase (public catalog reads only; auth was removed) ---
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# --- Neon ---
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"
NEON_BRANCH="production"
NEON_AUTH_BASE_URL=""
NEON_AUTH_JWKS_URL=""

# --- AWS (S3-compatible object storage) ---
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_ENDPOINT_URL_S3=""
AWS_REGION=""
